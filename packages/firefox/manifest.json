{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "__VERSION__",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "homepage_url": "https://github.com/nx-alejandrolacasa/mr-pully",
  "developer": {
    "name": "Alejandro Lacasa",
    "url": "https://github.com/nx-alejandrolacasa"
  },
  "permissions": ["storage", "alarms", "tabs", "tabGroups"],
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/toolbar-dark.svg",
    "theme_icons": [
      { "light": "icons/toolbar-light.svg", "dark": "icons/toolbar-dark.svg", "size": 16 },
      { "light": "icons/toolbar-light.svg", "dark": "icons/toolbar-dark.svg", "size": 32 }
    ]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "mr-pully@nx-alejandrolacasa.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["authenticationInfo"] }
    }
  }
}
